{
  "expo": {
    "name": "CivicConnectApp",
    "slug": "CivicConnectApp",
    "scheme": "civicconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/applogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/applogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.CivicConnectApp"
    },
    "web": {
      "favicon": "./assets/applogo.png"
    },
    "plugins": ["expo-web-browser", "expo-notifications"]
  }
}
